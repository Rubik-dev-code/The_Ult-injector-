        btn.style.padding = '11px';
        btn.style.margin = '7px 0';
        btn.style.border = 'none';
        btn.style.borderRadius = '6px';
        btn.style.background = `linear-gradient(135deg, ${gradientStart}, ${gradientEnd})`;
        btn.style.color = '#ffffff';
        btn.style.fontWeight = 'bold';
        btn.style.fontSize = '14px';
        btn.style.cursor = 'pointer';
        btn.style.boxShadow = '0 2px 5px rgba(0,0,0,0.5)';
        btn.style.transition = 'transform 0.1s, box-shadow 0.2s';
        
        btn.onmouseover = () => {
            btn.style.transform = 'scale(1.02)';
            btn.style.boxShadow = `0 0 10px ${gradientEnd}`;
        };
        btn.onmouseout = () => {
            btn.style.transform = 'scale(1)';
            btn.style.boxShadow = '0 2px 5px rgba(0,0,0,0.5)';
        };
        btn.onclick = onClickFunction;
        
